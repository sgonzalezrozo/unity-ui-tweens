{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sgonzalezrozo/unity-ui-tweens/blob/main/Documentation~/benchmarks/benchmark-result.schema.json",
  "title": "Benchmark Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool",
    "schemaVersion",
    "timestampUtc",
    "session",
    "workload",
    "metrics"
  ],
  "properties": {
    "tool": {
      "type": "string",
      "enum": [
        "ui-tweens",
        "fast-ioc"
      ]
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "timestampUtc": {
      "type": "string",
      "format": "date-time"
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceName",
        "deviceModel",
        "osVersion",
        "unityVersion",
        "gitCommit",
        "buildMode",
        "scriptingBackend"
      ],
      "properties": {
        "deviceName": {
          "type": "string",
          "minLength": 1
        },
        "deviceModel": {
          "type": "string",
          "minLength": 1
        },
        "osVersion": {
          "type": "string",
          "minLength": 1
        },
        "unityVersion": {
          "type": "string",
          "minLength": 1
        },
        "gitCommit": {
          "type": "string",
          "pattern": "^(?!0+$)[0-9a-fA-F]{7,40}$"
        },
        "buildMode": {
          "type": "string",
          "enum": [
            "Release",
            "Development"
          ]
        },
        "scriptingBackend": {
          "type": "string",
          "enum": [
            "IL2CPP",
            "Mono"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileOrScenario",
        "variant",
        "runIndex"
      ],
      "properties": {
        "profileOrScenario": {
          "type": "string",
          "minLength": 1
        },
        "variant": {
          "type": "string",
          "minLength": 1
        },
        "runIndex": {
          "type": "integer",
          "minimum": 1
        },
        "totalRuns": {
          "type": "integer",
          "minimum": 1
        },
        "warmupFrames": {
          "type": "integer",
          "minimum": 0
        },
        "measuredFrames": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer"
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "unit"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "enum": [
              "ms",
              "bytes",
              "count",
              "mb",
              "percent"
            ]
          },
          "aggregation": {
            "type": "string",
            "enum": [
              "single",
              "median",
              "p95",
              "mean",
              "max",
              "min"
            ]
          }
        }
      }
    }
  }
}
